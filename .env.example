# Copy to .env.local and fill in. .env.local is git-ignored; never put these
# values in .env, which is committed.
#
# Gate for /quote-calculator. Both are required — with either missing the tool
# refuses to unlock for anyone.

# The password staff type to open the calculator. Make it long; the only real
# protection here is its length.
QUOTE_PASSWORD=

# Signs the session cookie so it cannot be forged. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
QUOTE_SESSION_SECRET=

# Postgres for the quote ledger. Optional: without it the calculator works in
# full but cannot save. A free Neon or Supabase database is plenty.
#   postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=
